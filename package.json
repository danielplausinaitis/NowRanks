{
  "name": "nowranks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:check": "node --env-file=.env server/scripts/checkDatabaseConnection.mjs",
    "supabase:check": "node --env-file=.env server/scripts/checkSupabaseConnection.mjs",
    "data:read-check": "node --env-file=.env server/scripts/checkPersistedData.mjs",
    "leaderboard:check": "node --env-file=.env server/scripts/checkLeaderboard.mjs",
    "live:read-check": "node --env-file=.env server/scripts/liveReadCheck.mjs",
    "live:schedule-plan": "node --env-file=.env server/scripts/scheduleLive.mjs",
    "live:schedule-once": "node --env-file=.env server/scripts/scheduleLive.mjs --once",
    "api:dev": "node --env-file=.env server/scripts/startApi.mjs",
    "ingest:replay": "node --env-file=.env server/scripts/ingestReplay.mjs",
    "ingest:replay:recover": "node --env-file=.env server/scripts/recoverStaleReplayIngestion.mjs",
    "ingest:live": "node --env-file=.env server/scripts/ingestLive.mjs",
    "live:discover-check": "node --env-file=.env server/scripts/checkLiveDiscovery.mjs",
    "live:measurement-check": "node --env-file=.env server/scripts/checkLiveMeasurement.mjs",
    "live:volume-check": "node --env-file=.env server/scripts/checkLiveSearchVolume.mjs",
    "live:shadow-check": "node --env-file=.env server/scripts/checkLiveShadowScores.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@vitejs/plugin-react": "latest",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
