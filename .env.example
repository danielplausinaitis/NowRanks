# Server-only PostgreSQL connection string. Keep the value in your untracked .env file.
SUPABASE_DATABASE_URL=

# Server-only Supabase Data API configuration. Use either a Supabase secret key or legacy service_role key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Required only to permit the development-only deterministic replay write script.
ALLOW_REPLAY_DATABASE_WRITE=

# Live ingestion defaults to dry-run. Real writes require LIVE_INGEST_DRY_RUN=false and ALLOW_LIVE_DATABASE_WRITE=true.
ALLOW_LIVE_DATABASE_WRITE=false
LIVE_INGEST_DRY_RUN=true
LIVE_INGEST_CANDIDATE_LIMIT=10
LIVE_INGEST_CYCLE_ID=
LIVE_INGEST_HISTORY_WINDOW=1Y
LIVE_INGEST_TRENDS_MODE=single
LIVE_INGEST_RECOVER_STALE=false
LIVE_SCHEDULER_ENABLED=false
LIVE_REFRESH_INTERVAL_MINUTES=240
LIVE_BASELINE_TTL_HOURS=24
LIVE_HISTORY_TTL_HOURS=4
LIVE_MAX_PROVIDER_COST_USD=

# Development stale-run threshold. Defaults to 15 minutes when unset.
INGESTION_STALE_AFTER_MINUTES=

# Non-secret development switch. false/empty keeps the bundled local replay provider.
VITE_USE_LEADERBOARD_API=false
# Browser rendering contract only. The API source remains LEADERBOARD_DATA_SOURCE on the server.
VITE_LEADERBOARD_DATA_SOURCE=replay

# Server-only API source. Allowed values: replay (default) or live. Never use VITE_ for this setting.
LEADERBOARD_DATA_SOURCE=replay

# Server-only live external-provider credentials. Live checks are read-only and never write to Supabase.
SERPAPI_API_KEY=
SERPAPI_DISCOVERY_GEO=
SERPAPI_DISCOVERY_HOURS=
SERPAPI_DISCOVERY_LANGUAGE=
SERPAPI_DISCOVERY_ONLY_ACTIVE=
SERPAPI_DISCOVERY_CATEGORY_ID=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION_CODE=
DATAFORSEO_LOCATION_NAME=
DATAFORSEO_LOCATION_COORDINATE=
DATAFORSEO_LANGUAGE_CODE=
DATAFORSEO_LANGUAGE_NAME=
DATAFORSEO_VOLUME_DATE_FROM=
DATAFORSEO_VOLUME_DATE_TO=
DATAFORSEO_SEARCH_PARTNERS=
DATAFORSEO_DATE_FROM=
DATAFORSEO_DATE_TO=
LIVE_MEASUREMENT_CATEGORY=

# Read-only shadow live scoring candidate limit. Defaults to 10; allowed range is 2-20.
LIVE_SHADOW_CANDIDATE_LIMIT=
# Shadow-only DataForSEO Trends retrieval: single (default) or batched (up to 5 keywords/request).
LIVE_SHADOW_TRENDS_MODE=
# Elapsed-time live shadow history window: 24H, 7D, 30D, or 1Y. Defaults to 1Y.
LIVE_SHADOW_HISTORY_WINDOW=
